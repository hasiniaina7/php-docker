FROM ubuntu:22.04

ARG PHP_VER=8.2
ENV DEBIAN_FRONTEND=noninteractive

# Base + PPA + PHP modules (includes php-fpm)
COPY ./files/base_packages.sh /docker_build/base_packages.sh
COPY ./files/php/bin_install_modules.sh /docker_build/bin_install_modules.sh
COPY ./files/php/bin_clean_directories.sh /docker_build/bin_clean_directories.sh
COPY ./files/php/php.ini /docker_build/php.ini
COPY ./files/php/fpm.conf /docker_build/fpm.conf
COPY ./files/php/php-fpm /docker_build/php-fpm

RUN set -eux;         chmod +x /docker_build/base_packages.sh /docker_build/bin_install_modules.sh /docker_build/bin_clean_directories.sh;         /docker_build/base_packages.sh;         /docker_build/bin_install_modules.sh ${PHP_VER};         /docker_build/bin_clean_directories.sh ${PHP_VER};         # put php.ini and fpm.conf in place if they exist in context
    if [ -f /docker_build/php.ini ]; then cp /docker_build/php.ini /etc/php/${PHP_VER}/cli/php.ini || true; fi;         if [ -f /docker_build/php.ini ]; then cp /docker_build/php.ini /etc/php/${PHP_VER}/fpm/php.ini || true; fi;         if [ -f /docker_build/fpm.conf ]; then cp /docker_build/fpm.conf /etc/php/${PHP_VER}/fpm/php-fpm.conf || true; fi;         if [ -f /docker_build/php-fpm ]; then cp /docker_build/php-fpm /etc/init.d/php${PHP_VER}-fpm || true; fi;         rm -rf /var/lib/apt/lists/*

EXPOSE 9000
CMD ["php-fpm8.2","-F"]
