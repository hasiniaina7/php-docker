# PHP FPM 8.2 sur Ubuntu 22.04 avec PPA ondrej/php
FROM ubuntu:22.04

ARG PHP_VER=8.2
ENV DEBIAN_FRONTEND=noninteractive TZ=UTC LANG=C.UTF-8 LC_ALL=C.UTF-8

# Outils + ajout du PPA ondrej/php AVANT toute install PHP
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        gnupg2 \
        lsb-release \
        software-properties-common && \
    add-apt-repository -y ppa:ondrej/php && \
    apt-get update && \
    rm -rf /var/lib/apt/lists/*

# Espace de build + scripts
RUN mkdir -p /docker_build
COPY ./files/php/bin_* /docker_build/

# Installer modules PHP via nos scripts (le PPA est déjà présent)
RUN chmod +x /docker_build/bin_* && \
    /docker_build/bin_install_modules.sh ${PHP_VER} && \
    /docker_build/bin_clean_directories.sh ${PHP_VER}

# Installer FPM lui-même (séparé pour la lisibilité)
RUN apt-get update && \
    apt-get install -y --no-install-recommends php${PHP_VER}-fpm && \
    ln -sf /usr/sbin/php-fpm${PHP_VER} /usr/sbin/php-fpm && \
    rm -rf /var/lib/apt/lists/*

EXPOSE 9000
STOPSIGNAL SIGQUIT
CMD ["php-fpm${PHP_VER}", "-F"]
